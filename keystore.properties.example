# MiniPic Signing Configuration
# Copy this template to a secure directory outside the repository.
# Set MINIPIC_KEYSTORE_PROPERTIES to the absolute path of that external file.
# Never commit the real properties file or keystore.
# Use an absolute storeFile path; on Windows use forward slashes.
storeFile=/absolute/path/to/minipic-release.jks
storePassword=CHANGE_ME
keyAlias=minipic-release
keyPassword=CHANGE_ME
